# Copy this file to .env and fill in your own Supabase project's values
# (Project Settings -> API in the Supabase dashboard). Both must start with
# EXPO_PUBLIC_ — that prefix is what tells Expo it's safe to inline into
# the client bundle. Leave both unset/blank to keep running on the
# on-device local store (no backend needed) — see services/config.ts.
#
# See supabase/README.md for the full setup walkthrough.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
